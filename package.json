{
  "name": "deepseek-deploy-assistant",
  "version": "0.2.0",
  "private": true,
  "main": "out/main/index.js",
  "description": "DeepSeek Deploy Assistant - Windows per-user deployment assistant for DeepSeek Harness",
  "copyright": "Copyright © 2026",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run tests/integration",
    "license:check": "tsx scripts/license-gate.ts --scope=product",
    "build:index": "tsx scripts/build-index.ts",
    "validate:index": "tsx scripts/validate-index.ts",
    "probe:registry": "tsx scripts/registry-probe.ts",
    "e2e:restore": "tsx scripts/d08-restore-e2e.ts",
    "verify": "npm run typecheck && npm run test && npm run license:check",
    "dist": "electron-vite build && electron-builder --win --dir --x64 && node scripts/set-win-version.mjs && electron-builder --win nsis --x64 --prepackaged release/win-unpacked",
    "dist:dir": "electron-vite build && electron-builder --win --dir --x64 && node scripts/set-win-version.mjs"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-plugin-market-index": "0.2.1-alpha.4",
    "@types/js-yaml": "4.0.9",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@types/yauzl": "^2.10.3",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "resedit": "1.7.2",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "js-yaml": "4.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "yauzl": "^3.2.0",
    "zod": "^3.24.1"
  }
}
