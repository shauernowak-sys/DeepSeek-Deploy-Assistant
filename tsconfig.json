{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "noEmit": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@dda/spec": ["packages/spec/src/index.ts"],
      "@dda/core": ["packages/core/src/index.ts"],
      "@dda/adapters": ["packages/adapters/src/index.ts"]
    }
  },
  "include": [
    "electron.vite.config.ts",
    "vitest.config.ts",
    "packages/**/*.ts",
    "apps/**/*.ts",
    "apps/**/*.tsx",
    "tests/**/*.ts"
  ]
}
